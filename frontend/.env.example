# =====================================================================
# Groundtruth frontend
# Copy to frontend/.env.local and adjust. Never commit .env.local
# =====================================================================
#
# Note what is NOT here: no LLM key, no Moss credentials, no LiveKit
# secret. The browser never receives a credential. All API calls go through
# the server-side proxy at src/app/api/gt/[...path]/route.ts, which runs on
# the Next.js server and attaches the token there.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into client JavaScript and is
# therefore public. Neither variable below is prefixed, and neither should be.

# ---------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------
# Where the FastAPI orchestrator is reachable from the Next.js server.
# Defaults to http://127.0.0.1:8000 when unset.
BACKEND_API_URL=http://127.0.0.1:8000

# Bearer token for the Groundtruth API. Leave blank while the backend runs
# with AUTH_DISABLED=true (the development default). Set it once you flip
# AUTH_DISABLED=false, using a token minted by the backend.
GROUNDTRUTH_API_TOKEN=
