# =====================================================================
# Groundtruth LiveKit voice agent
# Copy to agent/.env and fill in. Never commit agent/.env
# =====================================================================

# ---------------------------------------------------------------------
# LiveKit — must match the values in backend/.env
# ---------------------------------------------------------------------
# From LiveKit Cloud, or populate automatically with:  lk app env
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dispatch name. Must match LIVEKIT_AGENT_NAME in backend/.env.
LIVEKIT_AGENT_NAME=groundtruth-agent

# ---------------------------------------------------------------------
# Groundtruth API
# ---------------------------------------------------------------------
# Where the orchestrator is reachable from the agent process.
GROUNDTRUTH_API_URL=http://127.0.0.1:8000

# Only needed when the backend runs with AUTH_DISABLED=false.
GROUNDTRUTH_API_TOKEN=

# Seconds to wait for the evaluation pipeline before giving up on a turn.
# RAGAS makes several LLM calls, so this is deliberately generous.
GROUNDTRUTH_TIMEOUT=45

# ---------------------------------------------------------------------
# Speech models
# ---------------------------------------------------------------------
# These run on LiveKit Inference, so no separate provider API key is needed.
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
