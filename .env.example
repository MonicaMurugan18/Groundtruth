# =====================================================================
# Groundtruth — environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of origins allowed to call the API (the Next.js app).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Secret used to sign Groundtruth's own JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-48-byte-urlsafe-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Set to false to require a bearer token on every protected endpoint.
# The frontend login flow (/login -> POST /auth/login) issues that token, so
# false is the correct setting for a demo or production deployment.
AUTH_DISABLED=false

# Per-client request ceiling for the evaluation endpoints.
RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------
# Database — PostgreSQL (trace store)
# ---------------------------------------------------------------------
# Matches docker-compose.yml. For a no-Docker dev run you may instead use:
#   DATABASE_URL=sqlite+aiosqlite:///./data/groundtruth.db
DATABASE_URL=postgresql+asyncpg://groundtruth:groundtruth@localhost:5432/groundtruth

# ---------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------
# Which provider powers RAG generation and the RAGAS evaluation judge.
# One of: openai | groq
# Groq speaks the OpenAI wire protocol, so both run through the same client
# and differ only by base URL, key and model name.
LLM_PROVIDER=openai

# ---------------------------------------------------------------------
# LLM — Groq (used when LLM_PROVIDER=groq)
# ---------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EVAL_MODEL=openai/gpt-oss-120b
#
# NOTE: Groq serves chat models only - it has no embedding models. RAGAS
# answer-relevance therefore uses the local EMBEDDING_MODEL below, which is
# also the model the corpus is indexed with. No embedding API key is needed
# for either provider.

# ---------------------------------------------------------------------
# LLM — OpenAI (used when LLM_PROVIDER=openai)
# ---------------------------------------------------------------------
# REQUIRED. Without this, generation and RAGAS scoring cannot run, and
# Groundtruth will report them as unavailable rather than inventing scores.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used to generate grounded RAG answers.
LLM_MODEL=gpt-4o-mini
# Model used as the RAGAS evaluation judge. Keep deterministic (temperature 0).
EVAL_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Optional: point at any OpenAI-compatible gateway (Groq, Together, OpenRouter).
# Leave blank to use OpenAI directly.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------
# Embeddings — Hugging Face (local, no API key required)
# ---------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------------------------------------------------------------------
# FAISS vector store
# ---------------------------------------------------------------------
FAISS_INDEX_PATH=./data/faiss
UPLOAD_DIR=./data/uploads
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------
# Moss — semantic retrieval engine  (https://docs.usemoss.dev/)
# ---------------------------------------------------------------------
# Variable names verified against livekit-examples/moss-hacker-starter.
# Obtain project credentials from the Moss dashboard.
# If these are blank, Groundtruth falls back to FAISS retrieval and clearly
# reports Moss as "not configured" — it never fabricates Moss results.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=groundtruth-knowledge
MOSS_MODEL_ID=moss-minilm
MOSS_TOP_K=5
# Hybrid search weighting passed to QueryOptions(alpha=...)
MOSS_ALPHA=0.8
# Retrieval backend: "moss" (primary, per architecture) or "faiss"
RETRIEVAL_BACKEND=moss

# ---------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------
# Guardrails AI's ToxicLanguage validator builds a Detoxify model the first
# time it loads, downloading several hundred MB of weights. That cost is paid
# during start-up, which can stall or time out a container deploy on a cold
# cache. Set this to true to skip the validator (and its download) entirely.
# It is skipped automatically when APP_ENV=development.
#
# The deterministic policies and DetectPII are unaffected either way.
DISABLE_TOXIC_LANGUAGE=false

# ---------------------------------------------------------------------
# Reliability thresholds — the gate that decides RELIABLE/REVIEW/FAILED
# ---------------------------------------------------------------------
FAITHFULNESS_THRESHOLD=0.70
RELEVANCE_THRESHOLD=0.70
CONTEXT_PRECISION_THRESHOLD=0.50

# ---------------------------------------------------------------------
# LiveKit — real-time voice  (https://docs.livekit.io/)
# ---------------------------------------------------------------------
# From LiveKit Cloud, or run: lk app env
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=groundtruth-agent

# =====================================================================
# PRODUCTION REFERENCE
# ---------------------------------------------------------------------
# The values below differ from the local defaults above. Set them on the
# deployed backend. With APP_ENV=production the API refuses to start if
# AUTH_DISABLED is true, JWT_SECRET_KEY is the default, or CORS is "*".
#
#   APP_ENV=production
#   AUTH_DISABLED=false
#   LLM_PROVIDER=groq
#   JWT_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
#   CORS_ORIGINS=https://your-frontend.vercel.app
#   DATABASE_URL=<paste the host's URL as-is; postgres:// and ?sslmode= are handled>
#   DISABLE_TOXIC_LANGUAGE=true   # skip the Detoxify download on cold starts
#
# Frontend (Vercel) needs exactly one variable, deliberately NOT NEXT_PUBLIC_:
#   BACKEND_API_URL=https://your-backend.onrender.com
#
# Voice agent (optional worker):
#   GROUNDTRUTH_API_URL=https://your-backend.onrender.com
#   GROUNDTRUTH_API_TOKEN=<mint with backend issue_token(); see README>
#
# Persistent disk required at backend/data/ (FAISS index + metadata).
# =====================================================================
